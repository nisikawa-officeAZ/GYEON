# =============================================================================
# DealerOS — Environment Variables Template
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is listed in .gitignore.
# Development use only. Production credentials are prohibited.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# REL-1 — Release identity (observability)
# -----------------------------------------------------------------------------
# The deployed Git commit SHA: EXACTLY 40 hexadecimal characters.
#
# It is the `release` field on every observability event, and it is what lets an
# operator answer "which build produced this incident?". A build with no release
# identity reports `release: "unknown"`, which is unattributable to any code.
#
# NORMALLY YOU DO NOT SET THIS. It is supplied automatically from the deployment
# Git SHA at build time (VERCEL_GIT_COMMIT_SHA when deploying on Vercel, or the
# local `git rev-parse HEAD` otherwise).
#
# Set it EXPLICITLY only for a self-hosted PRODUCTION build where Git metadata is
# unavailable — a source tarball, a shallow checkout, or a container built
# without the .git directory. In that case a production build FAILS CLOSED until
# this is provided, rather than shipping an unattributable release.
#
# If both this and VERCEL_GIT_COMMIT_SHA are set they must be IDENTICAL; a
# disagreement fails the build rather than silently picking one.
#
# NOT A SECRET: this is a public build identifier, already public in the
# repository, and it is intentionally inlined into the browser bundle.
NEXT_PUBLIC_GIT_COMMIT=
